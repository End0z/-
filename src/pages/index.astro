---
import ThemePage from '../components/ThemePage.astro';
import WatchMockup from '../components/WatchMockup.astro';
import { sakuraTheme } from '../data/themes';
import '../styles/global.css';

const features = [
  ['安心到家', '让家人知道放学后已经安全到家。'],
  ['家人联系', '想念家人的时候，一键发起联系。'],
  ['安静上课', '校园模式让手表懂得什么时候应该安静。'],
  ['紧急帮助', '真正需要帮助时，快速联系家人。']
];
---

<ThemePage theme={sakuraTheme} mockupComponent={WatchMockup} features={features} />
