---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import WatchMockup from '../components/WatchMockup.astro';
import ColorSelector from '../components/ColorSelector.astro';
import '../styles/global.css';
---
<BaseLayout>
  <div id="top" class="min-h-screen overflow-hidden bg-[#FFF9FA]">
    <Header />
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-0 overflow-hidden">
      {[...Array(9)].map((_, i) => <span class="petal" style={`left:${8 + i * 10}%; animation-duration:${8 + i * 1.7}s; animation-delay:${i * -1.8}s;`}></span>)}
    </div>

    <main class="relative z-10">
      <section class="mx-auto grid min-h-screen max-w-6xl items-center gap-12 px-5 pb-16 pt-32 sm:px-8 lg:grid-cols-[1fr_.95fr] lg:pt-24">
        <div class="reveal max-w-2xl">
          <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-rose-100 bg-white/70 px-3 py-1.5 text-xs font-medium text-[#A36A7A] shadow-sm">
            <span class="h-2 w-2 rounded-full bg-[#E889A3]"></span> Sakura Bloom · Concept 01
          </div>
          <h1 class="text-5xl font-semibold leading-[1.02] tracking-[-.04em] text-[#5B3D46] sm:text-7xl">春天落在<br /><span class="text-[#E889A3]">手腕上。</span></h1>
          <p class="mt-7 max-w-xl text-base leading-8 text-[#7D6670] sm:text-lg">不是把手表染成粉色，而是把樱花、微风与一点点安静的仪式感，变成孩子每天都会戴着的设计。</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href="#design" class="rounded-full bg-[#5B3D46] px-6 py-3 font-semibold text-white shadow-lg shadow-rose-200 transition hover:-translate-y-0.5">认识 Sakura Pink</a>
            <a href="#features" class="rounded-full border border-[#E8D8DE] bg-white/70 px-6 py-3 font-semibold text-[#5B3D46] transition hover:-translate-y-0.5">看看细节</a>
          </div>
          <div class="mt-10 flex gap-8 text-xs text-[#907982]">
            <div><div class="font-semibold text-[#5B3D46]">01</div><div class="mt-1">樱花粉</div></div>
            <div><div class="font-semibold text-[#5B3D46]">700ms</div><div class="mt-1">抬腕动画</div></div>
            <div><div class="font-semibold text-[#5B3D46]">5</div><div class="mt-1">主题配色</div></div>
          </div>
        </div>
        <div class="relative flex min-h-[560px] items-center justify-center">
          <div class="absolute h-72 w-72 rounded-full bg-[#FBE3EA] blur-3xl sm:h-96 sm:w-96"></div>
          <div class="relative z-10"><WatchMockup /></div>
          <div class="absolute bottom-7 right-4 hidden rounded-3xl bg-white/70 p-4 text-xs text-[#7D6670] shadow-xl shadow-rose-100 sm:block">
            <div class="font-semibold text-[#5B3D46]">One tiny detail</div>
            <div class="mt-1">最后一片花瓣停在屏幕角落。</div>
          </div>
        </div>
      </section>

      <section id="design" class="mx-auto grid max-w-6xl gap-12 px-5 py-24 sm:px-8 lg:grid-cols-[.8fr_1.2fr] lg:items-end">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[.22em] text-[#E889A3]">Design language</p>
          <h2 class="mt-4 text-4xl font-semibold tracking-tight sm:text-6xl">可爱，但不幼稚。</h2>
        </div>
        <div class="grid gap-6 text-sm leading-7 text-[#7D6670] sm:grid-cols-2">
          <div class="rounded-3xl border border-rose-100 bg-white/70 p-6"><div class="text-lg font-semibold text-[#5B3D46]">花瓣纹理</div><p class="mt-2">距离一米看，是干净的粉色。靠近以后，才会发现表带上极浅的花瓣纹理。</p></div>
          <div class="rounded-3xl border border-rose-100 bg-white/70 p-6"><div class="text-lg font-semibold text-[#5B3D46]">樱花表冠</div><p class="mt-2">把传统旋钮变成极简的樱花轮廓，让功能件自然成为品牌识别点。</p></div>
          <div class="rounded-3xl border border-rose-100 bg-white/70 p-6"><div class="text-lg font-semibold text-[#5B3D46]">暖雪白</div><p class="mt-2">不是用纯白制造冷感，而是让奶油般的暖白成为粉色的留白空间。</p></div>
          <div class="rounded-3xl border border-rose-100 bg-white/70 p-6"><div class="text-lg font-semibold text-[#5B3D46]">静谧动画</div><p class="mt-2">动画不抢注意力。花瓣轻落、微风吹开，时间自然出现。</p></div>
        </div>
      </section>

      <section id="features" class="bg-[#5B3D46] text-white">
        <div class="mx-auto max-w-6xl px-5 py-24 sm:px-8">
          <div class="max-w-2xl"><p class="text-sm font-semibold uppercase tracking-[.22em] text-[#F6B7C8]">Designed for real days</p><h2 class="mt-4 text-4xl font-semibold tracking-tight sm:text-6xl">真正需要的时候，<br />它应该很可靠。</h2></div>
          <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {[
              ['安心到家', '让家人知道放学后已经安全到家。'],
              ['家人联系', '想念家人的时候，一键发起联系。'],
              ['安静上课', '校园模式让手表懂得什么时候应该安静。'],
              ['紧急帮助', '真正需要帮助时，快速联系家人。']
            ].map(([title, body], i) => <article class="rounded-3xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm"><div class="text-xs text-[#F6B7C8]">0{i + 1}</div><h3 class="mt-7 text-lg font-semibold">{title}</h3><p class="mt-3 text-sm leading-7 text-white/60">{body}</p></article>)}
          </div>
        </div>
      </section>

      <ColorSelector />

      <section class="mx-auto max-w-6xl px-5 pb-28 pt-10 text-center sm:px-8">
        <div class="mx-auto max-w-3xl rounded-[2.5rem] border border-rose-100 bg-white/75 px-6 py-14 shadow-xl shadow-rose-100/50 sm:px-12">
          <div class="mx-auto mb-5 h-10 w-10 rounded-[70%_30%_70%_30%] bg-[#F6B7C8] rotate-[24deg]"></div>
          <p class="text-sm font-semibold uppercase tracking-[.22em] text-[#E889A3]">Sakura Bloom</p>
          <h2 class="mt-4 text-3xl font-semibold tracking-tight sm:text-5xl">儿童产品，也值得被认真设计。</h2>
          <p class="mx-auto mt-5 max-w-xl text-sm leading-7 text-[#806A72]">孩子看到会喜欢，父母看到不会觉得幼稚，戴了一年以后仍然愿意戴上它。</p>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>
