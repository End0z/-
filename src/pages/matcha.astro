---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import MatchaMockup from '../components/themes/MatchaMockup.astro';
import ColorSelector from '../components/ColorSelector.astro';
import '../styles/global.css';
---
<BaseLayout>
  <div id="top" class="min-h-screen overflow-hidden bg-[#FAFCF8] text-[#314338]">
    <Header />
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-0 overflow-hidden">
      {[...Array(7)].map((_, i) => <span class="leaf" style={`left:${10 + i * 12}%; animation-duration:${9 + i * 1.3}s; animation-delay:${i * -1.9}s;`}></span>)}
    </div>
    <main class="relative z-10">
      <section class="mx-auto grid min-h-screen max-w-6xl items-center gap-12 px-5 pb-16 pt-32 sm:px-8 lg:grid-cols-[1fr_.95fr] lg:pt-24">
        <div class="reveal max-w-2xl">
          <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-emerald-100 bg-white/75 px-3 py-1.5 text-xs font-medium text-[#668260] shadow-sm"><span class="h-2 w-2 rounded-full bg-[#7FA56F]"></span> Matcha Green · Concept 02</div>
          <h1 class="text-5xl font-semibold leading-[1.02] tracking-[-.04em] text-[#314338] sm:text-7xl">把春天戴在<br /><span class="text-[#7FA56F]">手腕上。</span></h1>
          <p class="mt-7 max-w-xl text-base leading-8 text-[#66796B] sm:text-lg">不做喧闹的荧光绿。我们把抹茶的柔和、嫩叶的呼吸感，以及一点点森林里的安静，放进儿童每天都会戴着的手表。</p>
          <div class="mt-9 flex flex-wrap gap-3"><a href="#design" class="rounded-full bg-[#314338] px-6 py-3 font-semibold text-white shadow-lg shadow-emerald-100 transition hover:-translate-y-0.5">认识 Matcha Green</a><a href="#colors" class="rounded-full border border-[#DDE9D8] bg-white/70 px-6 py-3 font-semibold text-[#314338] transition hover:-translate-y-0.5">选择其它颜色</a></div>
          <div class="mt-10 flex gap-8 text-xs text-[#809084]"><div><div class="font-semibold text-[#314338]">02</div><div class="mt-1">抹茶绿</div></div><div><div class="font-semibold text-[#314338]">Leaf</div><div class="mt-1">嫩叶交互</div></div><div><div class="font-semibold text-[#314338]">5</div><div class="mt-1">主题配色</div></div></div>
        </div>
        <div class="relative flex min-h-[560px] items-center justify-center"><div class="absolute h-72 w-72 rounded-full bg-[#E7F1DF] blur-3xl sm:h-96 sm:w-96"></div><div class="relative z-10"><MatchaMockup /></div><div class="absolute bottom-7 right-4 hidden rounded-3xl bg-white/75 p-4 text-xs text-[#66796B] shadow-xl shadow-emerald-100 sm:block"><div class="font-semibold text-[#314338]">One tiny detail</div><div class="mt-1">抬腕时，一片嫩叶掠过屏幕。</div></div></div>
      </section>
      <section id="design" class="mx-auto grid max-w-6xl gap-12 px-5 py-24 sm:px-8 lg:grid-cols-[.8fr_1.2fr] lg:items-end"><div><p class="text-sm font-semibold uppercase tracking-[.22em] text-[#7FA56F]">Design language</p><h2 class="mt-4 text-4xl font-semibold tracking-tight sm:text-6xl">清新，但不喧闹。</h2></div><div class="grid gap-6 text-sm leading-7 text-[#66796B] sm:grid-cols-2"><div class="rounded-3xl border border-emerald-100 bg-white/70 p-6"><div class="text-lg font-semibold text-[#314338]">嫩叶表带</div><p class="mt-2">表带不是高饱和绿色，而是像新叶一样的低饱和抹茶绿，近看才会发现细微叶脉。</p></div><div class="rounded-3xl border border-emerald-100 bg-white/70 p-6"><div class="text-lg font-semibold text-[#314338]">奶白留白</div><p class="mt-2">用温柔的奶白平衡绿色，把视觉重心留给产品，而不是装饰。</p></div><div class="rounded-3xl border border-emerald-100 bg-white/70 p-6"><div class="text-lg font-semibold text-[#314338]">叶片表冠</div><p class="mt-2">把旋钮做成极简叶片轮廓，像一枚隐藏在表壳侧面的品牌签名。</p></div><div class="rounded-3xl border border-emerald-100 bg-white/70 p-6"><div class="text-lg font-semibold text-[#314338]">微风动画</div><p class="mt-2">抬腕时，一片小叶从屏幕边缘轻轻掠过，时间随后自然浮现。</p></div></div></section>
      <section class="bg-[#314338] text-white"><div class="mx-auto max-w-6xl px-5 py-24 sm:px-8"><div class="max-w-2xl"><p class="text-sm font-semibold uppercase tracking-[.22em] text-[#B7D7A8]">A calmer colorway</p><h2 class="mt-4 text-4xl font-semibold tracking-tight sm:text-6xl">让科技，也有一点植物的呼吸感。</h2></div><div class="mt-14 grid gap-4 sm:grid-cols-3"><article class="rounded-3xl border border-white/10 bg-white/5 p-6"><div class="text-xs text-[#B7D7A8]">01</div><h3 class="mt-7 text-lg font-semibold">自然</h3><p class="mt-3 text-sm leading-7 text-white/60">不把儿童设计等同于高饱和色彩。</p></article><article class="rounded-3xl border border-white/10 bg-white/5 p-6"><div class="text-xs text-[#B7D7A8]">02</div><h3 class="mt-7 text-lg font-semibold">耐看</h3><p class="mt-3 text-sm leading-7 text-white/60">孩子喜欢，父母也不会觉得太幼稚。</p></article><article class="rounded-3xl border border-white/10 bg-white/5 p-6"><div class="text-xs text-[#B7D7A8]">03</div><h3 class="mt-7 text-lg font-semibold">可延展</h3><p class="mt-3 text-sm leading-7 text-white/60">同一结构可以自然扩展到完整色彩家族。</p></article></div></div></section>
      <ColorSelector />
      <section class="mx-auto max-w-6xl px-5 pb-28 pt-10 text-center sm:px-8"><div class="mx-auto max-w-3xl rounded-[2.5rem] border border-emerald-100 bg-white/75 px-6 py-14 shadow-xl shadow-emerald-100/50 sm:px-12"><div class="mx-auto mb-5 h-10 w-14 rounded-full bg-[#B7D7A8] rotate-[-16deg]"></div><p class="text-sm font-semibold uppercase tracking-[.22em] text-[#7FA56F]">Matcha Green</p><h2 class="mt-4 text-3xl font-semibold tracking-tight sm:text-5xl">把春天留在身边。</h2><p class="mx-auto mt-5 max-w-xl text-sm leading-7 text-[#66796B]">清爽、自然、安静。让每一次抬腕，都像经过一阵很轻的风。</p></div></section>
    </main>
  </div>
</BaseLayout>
