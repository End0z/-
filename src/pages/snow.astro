---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import SnowMockup from '../components/themes/SnowMockup.astro';
import ColorSelector from '../components/ColorSelector.astro';
import '../styles/global.css';
---
<BaseLayout>
  <div id="top" class="min-h-screen overflow-hidden bg-[#F8FCFF] text-[#30414F]">
    <Header />
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-0 overflow-hidden">
      {[...Array(12)].map((_, i) => <span class="snow-drift" style={`left:${5 + i * 8}%; animation-duration:${10 + i * 0.6}s; animation-delay:${i * -1.3}s; opacity:${0.18 + (i % 4) * 0.08};`}>✦</span>)}
    </div>
    <main class="relative z-10">
      <section class="mx-auto grid min-h-screen max-w-6xl items-center gap-12 px-5 pb-16 pt-32 sm:px-8 lg:grid-cols-[1fr_.95fr] lg:pt-24">
        <div class="reveal max-w-2xl">
          <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-sky-100 bg-white/75 px-3 py-1.5 text-xs font-medium text-[#66859D] shadow-sm"><span class="h-2 w-2 rounded-full bg-[#6EA8CF]"></span> Snow Blue · Concept 03</div>
          <h1 class="text-5xl font-semibold leading-[1.02] tracking-[-.04em] text-[#30414F] sm:text-7xl">把一场小雪<br /><span class="text-[#6EA8CF]">戴在腕间。</span></h1>
          <p class="mt-7 max-w-xl text-base leading-8 text-[#6D808F] sm:text-lg">不是把儿童产品做成冰冷的蓝色科技。我们把雪雾、冰晶和冬天的安静，收进一块轻盈的手表里，让每一次抬腕都像接住一片刚好落下的雪。</p>
          <div class="mt-9 flex flex-wrap gap-3"><a href="#design" class="rounded-full bg-[#30414F] px-6 py-3 font-semibold text-white shadow-lg shadow-sky-100 transition hover:-translate-y-0.5">认识 Snow Blue</a><a href="#colors" class="rounded-full border border-[#DDEBF4] bg-white/70 px-6 py-3 font-semibold text-[#30414F] transition hover:-translate-y-0.5">选择其它颜色</a></div>
          <div class="mt-10 flex gap-8 text-xs text-[#8295A4]"><div><div class="font-semibold text-[#30414F]">03</div><div class="mt-1">雪花蓝</div></div><div><div class="font-semibold text-[#30414F]">Snow</div><div class="mt-1">冰晶交互</div></div><div><div class="font-semibold text-[#30414F]">5</div><div class="mt-1">主题配色</div></div></div>
        </div>
        <div class="relative flex min-h-[560px] items-center justify-center"><div class="absolute h-72 w-72 rounded-full bg-[#E6F3FA] blur-3xl sm:h-96 sm:w-96"></div><div class="relative z-10"><SnowMockup /></div><div class="absolute bottom-7 right-4 hidden rounded-3xl bg-white/75 p-4 text-xs text-[#6D808F] shadow-xl shadow-sky-100 sm:block"><div class="font-semibold text-[#30414F]">One tiny detail</div><div class="mt-1">抬腕时，冰晶先亮起，时间随后出现。</div></div></div>
      </section>
      <section id="design" class="mx-auto grid max-w-6xl gap-12 px-5 py-24 sm:px-8 lg:grid-cols-[.8fr_1.2fr] lg:items-end"><div><p class="text-sm font-semibold uppercase tracking-[.22em] text-[#6EA8CF]">Design language</p><h2 class="mt-4 text-4xl font-semibold tracking-tight sm:text-6xl">安静，清透，像一片雪。</h2></div><div class="grid gap-6 text-sm leading-7 text-[#6D808F] sm:grid-cols-2"><div class="rounded-3xl border border-sky-100 bg-white/70 p-6"><div class="text-lg font-semibold text-[#30414F]">半透明冰雪表带</div><p class="mt-2">让表带有一点雪糖般的透感，避免纯蓝塑料的廉价感。</p></div><div class="rounded-3xl border border-sky-100 bg-white/70 p-6"><div class="text-lg font-semibold text-[#30414F]">雪雾留白</div><p class="mt-2">用大面积雪雾白压低视觉噪音，让产品像冬日晨光一样干净。</p></div><div class="rounded-3xl border border-sky-100 bg-white/70 p-6"><div class="text-lg font-semibold text-[#30414F]">六角雪花表冠</div><p class="mt-2">把传统旋钮替换成极简雪花轮廓，成为隐藏式的品牌签名。</p></div><div class="rounded-3xl border border-sky-100 bg-white/70 p-6"><div class="text-lg font-semibold text-[#30414F]">冰晶亮屏</div><p class="mt-2">抬腕时先点亮冰晶，再让时间从雾气般的背景中浮现。</p></div></div></section>
      <section class="bg-[#30414F] text-white"><div class="mx-auto max-w-6xl px-5 py-24 sm:px-8"><div class="max-w-2xl"><p class="text-sm font-semibold uppercase tracking-[.22em] text-[#B9D9EE]">A winter pause</p><h2 class="mt-4 text-4xl font-semibold tracking-tight sm:text-6xl">让科技，也有一点冬天的安静。</h2></div><div class="mt-14 grid gap-4 sm:grid-cols-3"><article class="rounded-3xl border border-white/10 bg-white/5 p-6"><div class="text-xs text-[#B9D9EE]">01</div><h3 class="mt-7 text-lg font-semibold">清透</h3><p class="mt-3 text-sm leading-7 text-white/60">让蓝色像冰晶，而不是荧光塑料。</p></article><article class="rounded-3xl border border-white/10 bg-white/5 p-6"><div class="text-xs text-[#B9D9EE]">02</div><h3 class="mt-7 text-lg font-semibold">安静</h3><p class="mt-3 text-sm leading-7 text-white/60">减少装饰，让产品拥有自己的留白。</p></article><article class="rounded-3xl border border-white/10 bg-white/5 p-6"><div class="text-xs text-[#B9D9EE]">03</div><h3 class="mt-7 text-lg font-semibold">有记忆点</h3><p class="mt-3 text-sm leading-7 text-white/60">一片雪、一道冰晶，就能认出 Snow Blue。</p></article></div></div></section>
      <ColorSelector />
      <section class="mx-auto max-w-6xl px-5 pb-28 pt-10 text-center sm:px-8"><div class="mx-auto max-w-3xl rounded-[2.5rem] border border-sky-100 bg-white/75 px-6 py-14 shadow-xl shadow-sky-100/50 sm:px-12"><div class="mx-auto mb-5 text-4xl text-[#6EA8CF]">✦</div><p class="text-sm font-semibold uppercase tracking-[.22em] text-[#6EA8CF]">Snow Blue</p><h2 class="mt-4 text-3xl font-semibold tracking-tight sm:text-5xl">把冬天的一片雪，留在手腕上。</h2><p class="mx-auto mt-5 max-w-xl text-sm leading-7 text-[#6D808F]">清澈、柔和、安静。让每一次抬腕，都像接住一片雪。</p></div></section>
    </main>
  </div>
</BaseLayout>
